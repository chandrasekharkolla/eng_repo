{
  "extends": ["config:base"],
  "timezone": "America/Chicago",
  "schedule": ["every 5 hours"],            // adjust to your testing cadence

  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["lambda-versions.yaml"],
      "matchStrings": [
        "\"python\":\\s*{\\s*\"current\":\\s*\"(?<currentValue>[^\\\"]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "public.ecr.aws/lambda/python",
      "extractVersionTemplate": "^python(?<version>\\d+\\.\\d+)$",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "fileMatch": ["lambda-versions.yaml"],
      "matchStrings": [
        "\"nodejs\":\\s*{\\s*\"current\":\\s*\"(?<currentValue>[^\\\"]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "public.ecr.aws/lambda/nodejs",
      "extractVersionTemplate": "^nodejs(?<version>\\d+\\.\\d+\\.x)$",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "fileMatch": ["lambda-versions.yaml"],
      "matchStrings": [
        "\"java\":\\s*{\\s*\"current\":\\s*\"(?<currentValue>[^\\\"]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "public.ecr.aws/lambda/java",
      "extractVersionTemplate": "^java(?<version>\\d+)$",
      "versioningTemplate": "loose"
    }
  ],

  "packageRules": [
    {
      "matchPackageNames": [
        "public.ecr.aws/lambda/python",
        "public.ecr.aws/lambda/nodejs",
        "public.ecr.aws/lambda/java"
      ],
      "groupName": "lambda-runtime-updates",
      "commitMessageTopic": "Update Lambda runtimes",
      "commitMessageExtra": "Automated bump from Docker registry"
    }
  ],

  "prCreation": "immediate",
  "automerge": false
}
